# Логи сервиса (stdout + файлы в папке).
LOGGER_LEVEL=debug
LOGGER_FOLDER=./out/logs

# HTTP-сервер API.
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=friday
POSTGRES_PASSWORD=change-me
POSTGRES_DB=friday
POSTGRES_TIMEOUT=5s

# Auth (JWT access + refresh in Postgres).
AUTH_JWT_SECRET=change-me-to-a-long-random-secret
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# Redis (кэш radar; клиент подключится в Phase 0).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
